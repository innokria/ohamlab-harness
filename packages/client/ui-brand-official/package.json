{
  "name": "@ohamlab/dsh-client-ui-brand-official",
  "version": "0.1.1-rc.2",
  "description": "OhamLab Harness branding plugin: custom brand name and floating fish overlay",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@ohamlab/dsh-client-runtime",
        "@ohamlab/dsh-client-ui-conversation",
        "@ohamlab/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "devDependencies": {
    "@ohamlab/cordis": "workspace:^",
    "@ohamlab/dsh-client-runtime": "workspace:^",
    "@ohamlab/dsh-client-ui-conversation": "workspace:^",
    "@ohamlab/dsh-client-ui-primitives": "workspace:^",
    "@ohamlab/dsh-client-ui-sidebar": "workspace:^",
    "@ohamlab/dsh-invariants": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
